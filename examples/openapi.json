    "/api/v1/tasks/{taskId}/completed/{completedAt}": {
      "get": {
        "description": "GetTask demonstrates automatic type conversion using registered codecs.",
        "operationId": "GetTask",
        "parameters": [
          {
            "description": "Uses TaskCodec for entity resolution",
            "in": "path",
            "name": "taskId",
            "required": true,
            "schema": {
              "description": "Task ID that resolves to full task information",
              "example": 1,
              "format": "int32",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Uses TimeCodec for RFC3339 parsing",
            "in": "path",
            "name": "completedAt",
            "required": true,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Uses PriorityCodec for enum validation",
            "in": "query",
            "name": "priority",
            "required": false,
            "schema": {
              "description": "Task priority level (internal iota, external string)",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "example": "medium",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTaskResponse"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "tags": [
          "tasks",
          "codecs"
        ]
      }
    },
