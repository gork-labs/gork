            "type": "string",
            "description": "UserID is the ID of the user"
          },
          "username": {
            "type": "string",
            "description": "Username is the username of the user"
          }
        },
        "description": "AdminUserType represents admin user data structure."
      },
      "BankOrCreditBody": {
        "type": "object",
        "title": "BankOrCreditBody"
      },
      "BankPaymentMethod": {
        "type": "object",
        "title": "BankPaymentMethod",
        "properties": {
          "accountNumber": {
            "type": "string",
