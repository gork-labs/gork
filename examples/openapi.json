      },
      "ErrorResponse": {
        "type": "object",
        "title": "ErrorResponse",
        "properties": {
          "details": {
            "type": "object",
            "description": "Additional error details"
          },
          "error": {
            "type": "string",
            "description": "Error message"
          }
        },
        "required": [
          "error"
        ],
        "description": "Generic error response structure"
      },
      "EventBody": {
        "type": "object",
        "title": "EventBody",
        "properties": {
          "account": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          },
          "created": {
            "type": "integer"
          },
